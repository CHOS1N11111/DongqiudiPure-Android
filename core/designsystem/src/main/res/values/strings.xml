    <!-- ── 缺失值 ─────────────────────────────────────────────────── -->
    <!-- MissingValue 的无障碍描述。视觉上是虚线破折号，读屏必须说清是「没有数据」
         而不是把破折号读成标点。 -->
    <string name="ds_no_data">暂无数据</string>

    <!-- ── section 默认空态 ───────────────────────────────────────── -->
    <string name="ds_section_empty_title">暂无内容</string>
    <string name="ds_section_empty_description">该板块目前没有可显示的数据。</string>

    <!-- ── 比赛状态 ───────────────────────────────────────────────── -->
    <string name="ds_match_live">进行中</string>
    <string name="ds_match_live_badge">LIVE</string>
    <string name="ds_match_halftime">中场</string>
    <string name="ds_match_halftime_secondary">休息</string>
    <string name="ds_match_not_started">未开始</string>
