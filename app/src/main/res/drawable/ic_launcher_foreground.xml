    <path
        android:pathData="M30,34 L78,34 A2,2 0 0 1 80,36 L80,72 A2,2 0 0 1 78,74 L30,74 A2,2 0 0 1 28,72 L28,36 A2,2 0 0 1 30,34 Z"
        android:strokeColor="#FF45DCC6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />

    <!-- 中线 -->
    <path
        android:pathData="M28,54 L80,54"
        android:strokeColor="#FF45DCC6"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- 中圈 -->
    <path
        android:pathData="M54,46 A8,8 0 1 1 53.99,46"
        android:strokeColor="#FF45DCC6"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
</vector>
